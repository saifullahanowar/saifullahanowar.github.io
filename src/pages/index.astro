---
import BaseLayout from '../layouts/BaseLayout.astro';
import { navLinks, profile, type SkillItem } from '../data/profile';

const skillCategories: {
  key: SkillItem['category'];
  title: string;
  badge: string;
  badgeClass: string;
}[] = [
  { key: 'Accounting & ERP', title: 'Accounting & ERP', badge: 'Core', badgeClass: 'chapter--mint' },
  {
    key: 'Spreadsheet & Systems',
    title: 'Spreadsheet & Systems',
    badge: 'Analysis',
    badgeClass: 'chapter--sand',
  },
  {
    key: 'Technical & Automation',
    title: 'Technical & Automation',
    badge: 'Tech',
    badgeClass: 'chapter--violet',
  },
];
---

<BaseLayout
  title={`${profile.fullName} — Accounting, Finance & ERP Portfolio`}
  description="Portfolio of Saifullah Anowar — Accounts & Finance Executive, ICMAB CMA candidate, MBA in Accounting, and Tally Prime & ERPNext practitioner."
  canonicalPath="/"
>
  <div class="container-page pt-5 sm:pt-7 space-y-5">
    <!-- Hero Sheet (Notebook Stage Layout) -->
    <section class="sheet p-4 sm:p-6 space-y-4">
      <!-- Breadcrumb + Metadata Tags -->
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="space-y-1">
          <p class="text-xs text-[var(--muted)] font-medium">
            00. Portfolio <span class="mx-1 text-[var(--muted-2)]">/</span> {profile.jobTitle}
          </p>
          <h1>
            Crafting Excellence in{' '}
            <span class="term-highlight">Accounting &amp; Tech</span>
          </h1>
          <p class="text-xs sm:text-[0.84rem] text-[var(--muted)] max-w-2xl pt-0.5">
            {profile.rolesLine}
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2 shrink-0">
          <span class="tag tag--sand">ICMAB (CMA)</span>
          <span class="tag tag--mint">MBA · Accounting</span>
          <span class="tag tag--violet">Tally &amp; ERPNext</span>
        </div>
      </div>

      <!-- Isometric Grid Stage -->
      <div class="stage-box p-4 sm:p-6">
        <!-- Isometric SVG Grid Background -->
        <svg
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 size-full opacity-75"
          preserveAspectRatio="xMidYMid slice"
        >
          <defs>
            <pattern id="iso-grid" width="48" height="27.7128" patternUnits="userSpaceOnUse">
              <path
                d="M 24 0 L 48 13.8564 L 24 27.7128 L 0 13.8564 Z"
                fill="none"
                stroke="var(--line)"
                stroke-width="1"
              />
            </pattern>
            <radialGradient id="iso-fade" cx="50%" cy="50%" r="55%">
              <stop offset="40%" stop-color="white" stop-opacity="1" />
              <stop offset="100%" stop-color="white" stop-opacity="0" />
            </radialGradient>
            <mask id="grid-mask">
              <rect width="100%" height="100%" fill="url(#iso-fade)" />
            </mask>
          </defs>
          <rect width="100%" height="100%" fill="url(#iso-grid)" mask="url(#grid-mask)" />
        </svg>

        <!-- Stage Content -->
        <div class="relative z-10 space-y-6">
          <!-- Top HUD Metric Chips -->
          <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-3 max-w-3xl">
            <div class="chip">
              <p class="chip__label">Current Role</p>
              <p class="chip__value truncate">{profile.jobTitle}</p>
            </div>
            <div class="chip chip--violet">
              <p class="chip__label">ERP Stack</p>
              <p class="chip__value truncate">Tally Prime &middot; ERPNext</p>
            </div>
            <div class="chip chip--rust">
              <p class="chip__label">Qualification</p>
              <p class="chip__value truncate">ICMAB (CMA) &middot; MBA</p>
            </div>
          </div>

          <!-- Center Stage Grid: Intro + Portrait -->
          <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-10 py-2">
            <div class="space-y-4 max-w-2xl">
              <p class="prose-justify text-[0.84rem] sm:text-[0.9rem] leading-relaxed text-[var(--ink-2)]">
                I am <strong class="font-extrabold text-[var(--ink)]">{profile.fullName}</strong>, an
                Accounts &amp; Finance professional and ICMAB CMA candidate combining hands-on
                financial operations with <code>Tally Prime</code>, <code>ERPNext</code>, and Excel
                automation.
              </p>

              <div class="flex flex-wrap items-center gap-3 pt-1">
                <a href="#experience" class="btn-pop">
                  View Experience
                  <svg
                    aria-hidden="true"
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
                <a href="#skills" class="btn-ghost">
                  Practical Skills
                </a>
              </div>
            </div>

            <figure class="mx-auto lg:mx-0 flex flex-col items-center gap-2.5 shrink-0">
              <div class="p-1.5 rounded-xl border-[1.5px] border-[var(--ink)] bg-[var(--elevated)] shadow-[var(--pop-shadow)]">
                <img
                  src={profile.portrait.src}
                  alt={profile.portrait.alt}
                  width={profile.portrait.width}
                  height={profile.portrait.height}
                  fetchpriority="high"
                  decoding="async"
                  class="block w-[176px] sm:w-[205px] h-auto aspect-square rounded-lg object-cover object-top border border-[var(--line-strong)]"
                />
              </div>
              <figcaption class="tag">
                <span
                  aria-hidden="true"
                  class="inline-block size-2 rounded-full bg-[var(--green-3)] border border-[var(--ink)]"
                />
                {profile.contact.websiteDisplay}
              </figcaption>
            </figure>
          </div>
        </div>
      </div>

      <!-- Horizontal Section Stepper -->
      <div class="surface-card p-3.5 sm:p-4 space-y-3">
        <div class="flex items-center justify-between gap-2">
          <span class="eyebrow">In This Portfolio</span>
          <span class="text-[0.7rem] font-semibold text-[var(--muted)]">
            {navLinks.length} Sections
          </span>
        </div>

        <nav aria-label="Portfolio sections" class="timeline-grid">
          {
            navLinks.map((link, idx) => (
              <a
                href={link.href}
                class:list={['timeline-step', idx === 0 && 'timeline-step--active']}
              >
                <span class="timeline-dot">{idx + 1}</span>
                <span>{link.label}</span>
              </a>
            ))
          }
        </nav>
      </div>
    </section>

    <!-- Two-Column Editorial Content Grid -->
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)] items-start">
      <!-- Left Main Column -->
      <div class="space-y-5">
        <!-- Professional Summary -->
        <section id="summary" aria-labelledby="summary-heading" class="surface-card p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between gap-3">
            <span class="eyebrow">Section 01 / 06</span>
            <span class="chapter chapter--violet">Profile</span>
          </div>

          <h2 id="summary-heading">Professional Summary</h2>

          <p class="prose-justify text-[0.84rem] leading-relaxed text-[var(--ink-2)]">
            {profile.summary}
          </p>

          <div class="callout-insight p-3.5 flex items-start gap-3">
            <span class="callout-icon" aria-hidden="true">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.1"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M9 18h6"></path>
                <path d="M10 22h4"></path>
                <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"></path>
              </svg>
            </span>
            <p class="prose-justify text-xs leading-relaxed text-[var(--ink-2)]">
              <strong class="font-bold text-[var(--ink)]">Focus areas:</strong> bank reconciliation,
              supplier payments, dealer commission preparation, inventory accounting, and costing.
            </p>
          </div>
        </section>

        <!-- Work Experience -->
        <section id="experience" aria-labelledby="experience-heading" class="surface-card p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between gap-3">
            <span class="eyebrow">Section 02 / 06</span>
            <span class="chapter chapter--mint">Career</span>
          </div>

          <h2 id="experience-heading">Work Experience</h2>

          <div class="space-y-4">
            {
              profile.experience.map((item) => (
                <article class="rounded-xl border border-[var(--line-strong)] bg-[var(--elevated)] p-4 sm:p-5 space-y-3">
                  <header class="space-y-2 pb-3 border-b border-[var(--line)]">
                    <div class="flex flex-col gap-1.5 sm:flex-row sm:items-center sm:justify-between">
                      <h3>{item.company}</h3>
                      <span class="tag tag--sand self-start sm:self-auto">{item.group}</span>
                    </div>
                    <p class="prose-justify text-xs leading-relaxed text-[var(--muted)]">{item.about}</p>
                  </header>

                  <div class="flex items-center gap-2.5">
                    <span
                      aria-hidden="true"
                      class="inline-block size-2.5 rounded-full bg-[var(--green-3)] border border-[var(--ink)] shrink-0"
                    />
                    <h4 class="text-sm font-bold text-[var(--ink)]">{item.role}</h4>
                  </div>
                </article>
              ))
            }
          </div>
        </section>
      </div>

      <!-- Right Rail Column -->
      <aside class="space-y-5">
        <!-- Professional Qualification -->
        <section id="qualification" aria-labelledby="qual-heading" class="surface-rail p-5 sm:p-6 space-y-3.5">
          <div class="flex items-center justify-between gap-3">
            <span class="eyebrow">Section 03 / 06</span>
            <span class="chapter chapter--sand">Certification</span>
          </div>

          <h2 id="qual-heading">Professional Qualification</h2>

          <div class="callout-tip p-3.5 space-y-1">
            <h3 class="text-[var(--ink)]">{profile.professionalQualification.title}</h3>
            <p class="text-xs text-[var(--ink-2)] leading-relaxed">
              {profile.professionalQualification.institute}
            </p>
          </div>
        </section>

        <!-- Education Qualification -->
        <section id="education" aria-labelledby="education-heading" class="surface-rail p-5 sm:p-6 space-y-3.5">
          <div class="flex items-center justify-between gap-3">
            <span class="eyebrow">Section 04 / 06</span>
            <span class="chapter chapter--orange">Academic</span>
          </div>

          <h2 id="education-heading">Education Qualification</h2>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-1">
            {
              profile.education.map((edu) => (
                <article class="rounded-xl border border-[var(--line-strong)] bg-[var(--elevated)] p-3.5 flex items-center justify-between gap-3">
                  <div>
                    <h3>{edu.degree}</h3>
                    <p class="text-xs text-[var(--muted)]">{edu.field}</p>
                  </div>
                  <span class="tag tag--mint">Degree</span>
                </article>
              ))
            }
          </div>
        </section>
      </aside>
    </div>

    <!-- Practical Skills -->
    <section id="skills" aria-labelledby="skills-heading" class="surface-card p-5 sm:p-6 space-y-5">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <span class="eyebrow">Section 05 / 06</span>
          <h2 id="skills-heading" class="mt-0.5">Practical Skills</h2>
        </div>
        <span class="tag tag--violet self-start sm:self-auto">6 Core Competencies</span>
      </div>

      <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
        {
          skillCategories.map((cat) => {
            const items = profile.skills.filter((s) => s.category === cat.key);
            return (
              <article class="rounded-xl border border-[var(--line-strong)] bg-[var(--elevated)] p-4 sm:p-5 space-y-4">
                <div class="flex items-center justify-between gap-2 pb-2.5 border-b border-[var(--line)]">
                  <h3>{cat.title}</h3>
                  <span class:list={['chapter', cat.badgeClass]}>{cat.badge}</span>
                </div>

                <div class="space-y-4">
                  {items.map((skill) => (
                    <div class="space-y-1.5">
                      <div class="flex items-baseline justify-between gap-3">
                        <div>
                          <p class="text-xs font-bold text-[var(--ink)]">{skill.name}</p>
                          {skill.detail && (
                            <p class="text-[0.7rem] text-[var(--muted)] mt-0.5">{skill.detail}</p>
                          )}
                        </div>
                        <span class="tabular-nums text-xs font-extrabold text-[var(--ink)] shrink-0">
                          {skill.level}%
                        </span>
                      </div>
                      <div
                        class="skill-track"
                        role="progressbar"
                        aria-label={`${skill.name} proficiency`}
                        aria-valuemin="0"
                        aria-valuemax="100"
                        aria-valuenow={skill.level}
                      >
                        <span class="skill-fill" style={`width: ${skill.level}%`} />
                      </div>
                    </div>
                  ))}
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    <!-- Official Website -->
    <section
      id="contact"
      aria-labelledby="contact-heading"
      class="surface-card p-5 sm:p-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="space-y-1">
        <div class="flex items-center gap-2.5">
          <span class="eyebrow">Section 06 / 06</span>
          <span class="chapter chapter--mint">Online</span>
        </div>
        <h2 id="contact-heading">Official Website</h2>
      </div>

      <a href={profile.contact.website} class="btn-pop self-start sm:self-auto">
        <svg
          aria-hidden="true"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.1"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        {profile.contact.websiteDisplay}
      </a>
    </section>
  </div>
</BaseLayout>
