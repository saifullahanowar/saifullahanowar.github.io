---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---

<BaseLayout
  title={`Projects — ${profile.fullName}`}
  description="ERPNext company setup, Astro static portfolio on GitHub Pages, and automated Excel financial dashboards by Saifullah Anowar."
  canonicalPath="/projects/"
  pageType="CollectionPage"
>
  <section class="border-b border-[var(--border)] bg-[var(--surface)]">
    <div class="container-editorial py-12 md:py-16 space-y-4">
      <p class="eyebrow">Portfolio Work</p>
      <h1 class="text-3xl sm:text-4xl font-bold">Selected Projects</h1>
      <p class="text-base text-[var(--text-muted)] max-w-2xl leading-relaxed">
        Focused implementations across ERP systems, web development, and Excel financial reporting
        designed for practical business workflows.
      </p>
    </div>
  </section>

  <section aria-label="Project list" class="container-editorial pt-12 md:pt-16">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      {
        profile.projects.map((project) => (
          <article class="card-editorial flex flex-col justify-between overflow-hidden">
            <div>
              <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border)] bg-[var(--surface-subtle)]">
                <span class="text-xs font-bold uppercase tracking-widest text-[var(--gold)]">
                  {project.category}
                </span>
                <span
                  aria-hidden="true"
                  class="inline-flex size-9 items-center justify-center rounded-lg bg-[var(--accent-soft)] text-[var(--accent)]"
                >
                  {project.id === 'erp' && (
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="3" y="3" width="7" height="7"></rect>
                      <rect x="14" y="3" width="7" height="7"></rect>
                      <rect x="14" y="14" width="7" height="7"></rect>
                      <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                  )}
                  {project.id === 'web' && (
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="10"></circle>
                      <line x1="2" y1="12" x2="22" y2="12"></line>
                      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                    </svg>
                  )}
                  {project.id === 'excel' && (
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <line x1="18" y1="20" x2="18" y2="10"></line>
                      <line x1="12" y1="20" x2="12" y2="4"></line>
                      <line x1="6" y1="20" x2="6" y2="14"></line>
                    </svg>
                  )}
                </span>
              </div>

              <div class="p-6 space-y-4">
                <h2 class="text-xl font-bold text-[var(--text)]">{project.title}</h2>
                <p class="text-sm text-[var(--text-muted)] leading-relaxed">
                  {project.description}
                </p>

                <ul class="space-y-2 pt-2 text-sm text-[var(--text-muted)]">
                  {project.features.map((feat) => (
                    <li class="flex items-start gap-2.5">
                      <svg
                        aria-hidden="true"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="mt-0.5 shrink-0 text-[var(--accent)]"
                      >
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="px-6 pb-6 pt-2">
              <a
                href={project.ctaHref}
                target={project.external ? '_blank' : undefined}
                rel={project.external ? 'noopener noreferrer' : undefined}
                class="btn-primary w-full text-sm"
              >
                {project.ctaLabel}
                {project.external ? (
                  <svg
                    aria-hidden="true"
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                ) : (
                  <svg
                    aria-hidden="true"
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                  </svg>
                )}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
