---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, type SkillItem } from '../data/profile';

const categories: {
  key: SkillItem['category'];
  title: string;
  description: string;
}[] = [
  {
    key: 'Accounting & ERP',
    title: 'Accounting & ERP Systems',
    description: 'Core financial ledger management, company setup, Chart of Accounts, and daily accounting operations.',
  },
  {
    key: 'Spreadsheet & Systems',
    title: 'Spreadsheet & Office Systems',
    description: 'Financial dashboards, analytical formulas, macros, and everyday operating system proficiency.',
  },
  {
    key: 'Technical & Automation',
    title: 'Technical & Automation',
    description: 'Modern web fundamentals and Python scripting for workflow efficiency.',
  },
];
---

<BaseLayout
  title={`Practical Skills — ${profile.fullName}`}
  description="Categorized accounting, ERP, spreadsheet, and technical skills of Saifullah Anowar, including Tally Prime, ERPNext, MS Excel, Web Development, and Python."
  canonicalPath="/skills/"
  pageType="WebPage"
>
  <section class="border-b border-[var(--border)] bg-[var(--surface)]">
    <div class="container-editorial py-12 md:py-16 space-y-4">
      <p class="eyebrow">Capabilities</p>
      <h1 class="text-3xl sm:text-4xl font-bold">Practical Skills</h1>
      <p class="text-base text-[var(--text-muted)] max-w-2xl leading-relaxed">
        A structured overview of the accounting software, ERP platforms, spreadsheet tools, and
        technical capabilities I apply in finance and business operations.
      </p>
    </div>
  </section>

  <section aria-label="Skill categories" class="container-editorial pt-12 md:pt-16 space-y-8">
    {
      categories.map((cat) => {
        const items = profile.skills.filter((s) => s.category === cat.key);
        return (
          <article class="card-editorial p-7 sm:p-9">
            <header class="pb-6 border-b border-[var(--border)] space-y-1.5">
              <h2 class="text-xl sm:text-2xl font-bold text-[var(--accent)]">{cat.title}</h2>
              <p class="text-sm text-[var(--text-muted)] max-w-2xl">{cat.description}</p>
            </header>

            <div class="mt-6 grid grid-cols-1 gap-x-10 gap-y-6 md:grid-cols-2">
              {items.map((skill) => (
                <div class="space-y-2.5">
                  <div class="flex items-baseline justify-between gap-4">
                    <div>
                      <h3 class="font-sans text-base font-bold text-[var(--text)]">
                        {skill.name}
                      </h3>
                      {skill.detail && (
                        <p class="text-xs sm:text-sm text-[var(--text-muted)] mt-0.5">
                          {skill.detail}
                        </p>
                      )}
                    </div>
                    <span class="tabular-nums text-sm font-bold text-[var(--accent)]">
                      {skill.level}%
                    </span>
                  </div>
                  <div
                    class="skill-track"
                    role="progressbar"
                    aria-label={`${skill.name} proficiency`}
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow={skill.level}
                  >
                    <span class="skill-fill" style={`width: ${skill.level}%`} />
                  </div>
                </div>
              ))}
            </div>
          </article>
        );
      })
    }

    <div class="card-editorial p-7 sm:p-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="space-y-1">
        <h2 class="text-xl font-bold">See these skills applied</h2>
        <p class="text-sm text-[var(--text-muted)]">
          Explore ERPNext, web, and Excel automation projects or generate an ATS-friendly resume.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/projects/" class="btn-primary text-sm">View Projects</a>
        <a href="/build/" class="btn-secondary text-sm">Resume Builder</a>
      </div>
    </div>
  </section>
</BaseLayout>
