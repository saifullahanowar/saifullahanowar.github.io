---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---

<BaseLayout
  title={`ATS Resume Builder — ${profile.fullName}`}
  description="Interactive two-column ATS-friendly resume builder with live preview and clean A4 PDF print layout."
  canonicalPath="/build/"
  pageType="WebPage"
>
  <section class="builder-intro border-b border-[var(--border)] bg-[var(--surface)]">
    <div class="container-editorial py-10 md:py-14 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="space-y-3 max-w-2xl">
        <p class="eyebrow">Interactive Tool</p>
        <h1 class="text-3xl sm:text-4xl font-bold">ATS Resume Builder</h1>
        <p class="text-sm sm:text-base text-[var(--text-muted)] leading-relaxed">
          Customize fields below and export a clean two-column A4 PDF using your browser’s print
          dialog. Changes stay locally in your browser and never leave your device.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <button type="button" id="btn-reset-resume" class="btn-secondary text-sm">
          Reset to Default
        </button>
        <button type="button" id="btn-print-resume" class="btn-primary text-sm">
          Print / Save as PDF
        </button>
      </div>
    </div>
  </section>

  <section
    id="resume-builder-root"
    aria-label="Resume editor and live preview"
    class="builder-workspace container-editorial pt-10"
  >
    <div class="builder-grid">
      <!-- Editor Pane -->
      <form class="editor-panel card-editorial" onsubmit="return false" aria-label="Resume fields">
        <fieldset class="rb-section">
          <legend class="rb-legend">Header &amp; Contact</legend>
          <div class="rb-field">
            <label class="rb-label" for="in-name">Full Name</label>
            <input type="text" id="in-name" class="rb-input" autocomplete="name" />
          </div>
          <div class="rb-field">
            <label class="rb-label" for="in-contact">Address, Email &amp; Links (new lines allowed)</label>
            <textarea id="in-contact" rows="3" class="rb-input"></textarea>
          </div>
          <div class="rb-field">
            <label class="rb-label" for="in-phone">Phone (optional — left blank by default)</label>
            <input
              type="tel"
              id="in-phone"
              class="rb-input"
              placeholder="e.g., +880 1XXX-XXXXXX"
              autocomplete="tel"
            />
          </div>
        </fieldset>

        <fieldset class="rb-section">
          <legend class="rb-legend">Professional Summary</legend>
          <div class="rb-field">
            <label class="rb-label" for="in-summary">Summary</label>
            <textarea id="in-summary" rows="4" class="rb-input"></textarea>
          </div>
        </fieldset>

        <fieldset class="rb-section">
          <legend class="rb-legend">Work Experience</legend>
          <div id="experience-list" class="space-y-4"></div>
          <button type="button" id="btn-add-exp" class="rb-btn-add">
            + Add Experience
          </button>
        </fieldset>

        <fieldset class="rb-section">
          <legend class="rb-legend">Practical Skills</legend>
          <div class="rb-field">
            <label class="rb-label" for="in-skills">Skills (one per line)</label>
            <textarea id="in-skills" rows="5" class="rb-input"></textarea>
          </div>
        </fieldset>

        <fieldset class="rb-section">
          <legend class="rb-legend">Professional Qualification</legend>
          <div class="rb-field">
            <label class="rb-label" for="in-prof-qual">Certifications / Programs</label>
            <textarea id="in-prof-qual" rows="4" class="rb-input"></textarea>
          </div>
        </fieldset>

        <fieldset class="rb-section">
          <legend class="rb-legend">Education Qualification</legend>
          <div id="education-list" class="space-y-4"></div>
          <button type="button" id="btn-add-edu" class="rb-btn-add">
            + Add Education
          </button>
        </fieldset>

        <fieldset class="rb-section">
          <legend class="rb-legend">Optional Personal Details</legend>
          <p class="text-xs text-[var(--text-subtle)] mb-3">
            Left blank by default for privacy. This section appears in the resume only when you fill
            in at least one field.
          </p>
          <div class="rb-grid-2">
            <div class="rb-field">
              <label class="rb-label" for="in-father">Father's Name</label>
              <input type="text" id="in-father" class="rb-input" placeholder="Optional" />
            </div>
            <div class="rb-field">
              <label class="rb-label" for="in-mother">Mother's Name</label>
              <input type="text" id="in-mother" class="rb-input" placeholder="Optional" />
            </div>
            <div class="rb-field">
              <label class="rb-label" for="in-dob">Date of Birth</label>
              <input type="text" id="in-dob" class="rb-input" placeholder="Optional" />
            </div>
            <div class="rb-field">
              <label class="rb-label" for="in-religion">Religion</label>
              <input type="text" id="in-religion" class="rb-input" placeholder="Optional" />
            </div>
            <div class="rb-field">
              <label class="rb-label" for="in-nationality">Nationality</label>
              <input type="text" id="in-nationality" class="rb-input" placeholder="Optional" />
            </div>
            <div class="rb-field">
              <label class="rb-label" for="in-marital">Marital Status</label>
              <input type="text" id="in-marital" class="rb-input" placeholder="Optional" />
            </div>
          </div>
        </fieldset>
      </form>

      <!-- Live A4 ATS Preview Pane -->
      <div class="preview-panel" aria-label="Live resume preview">
        <article class="resume-sheet" id="resume-sheet">
          <header class="pv-top-header">
            <p class="pv-resume-of">CURRICULUM VITAE</p>
            <h2 id="pv-name" class="pv-name"></h2>
            <div id="pv-contact" class="pv-contact"></div>
          </header>

          <div class="pv-body">
            <!-- Left Sidebar Column -->
            <div class="pv-col-left">
              <section class="pv-section">
                <h3 class="pv-section-title">Practical Skills</h3>
                <div id="pv-skills" class="pv-list-box"></div>
              </section>

              <section class="pv-section">
                <h3 class="pv-section-title">Professional Qualification</h3>
                <div id="pv-prof-qual" class="pv-pre-text"></div>
              </section>

              <section id="pv-personal-section" class="pv-section" hidden>
                <h3 class="pv-section-title">Personal Details</h3>
                <div id="pv-personal-list"></div>
              </section>
            </div>

            <!-- Right Main Column -->
            <div class="pv-col-right">
              <section class="pv-section">
                <h3 class="pv-section-title">Professional Summary</h3>
                <p id="pv-summary" class="pv-text"></p>
              </section>

              <section class="pv-section">
                <h3 class="pv-section-title">Work Experience</h3>
                <div id="pv-experience-container"></div>
              </section>

              <section class="pv-section">
                <h3 class="pv-section-title">Education Qualification</h3>
                <div id="pv-education-container"></div>
              </section>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Isolated client-side island: loaded ONLY on /build/ -->
  <script>
    import '../scripts/resume-builder';
  </script>

  <style is:global>
    .builder-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: 2rem;
      align-items: start;
    }

    .editor-panel {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .rb-section {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.15rem;
      background-color: var(--surface-subtle);
      margin: 0;
    }

    .rb-legend {
      font-family: var(--font-serif);
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--accent);
      padding-inline: 0.4rem;
    }

    .rb-field {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      margin-bottom: 0.85rem;
    }

    .rb-field:last-child {
      margin-bottom: 0;
    }

    .rb-label {
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    .rb-input {
      width: 100%;
      padding: 0.6rem 0.8rem;
      border-radius: 7px;
      border: 1px solid var(--border-strong);
      background-color: var(--surface);
      color: var(--text);
      font-family: var(--font-sans);
      font-size: 0.875rem;
      line-height: 1.45;
    }

    .rb-input:focus-visible {
      border-color: var(--accent);
    }

    .rb-grid-2 {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .rb-item-card {
      padding: 0.9rem;
      border-radius: 8px;
      border: 1px solid var(--border);
      background-color: var(--surface);
    }

    .rb-item-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.75rem;
    }

    .rb-item-title {
      font-size: 0.8125rem;
      font-weight: 700;
      color: var(--text);
    }

    .rb-btn-add {
      margin-top: 0.75rem;
      width: 100%;
      padding: 0.55rem 0.9rem;
      border-radius: 7px;
      border: 1px dashed var(--accent);
      background-color: transparent;
      color: var(--accent);
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
    }

    .rb-btn-add:hover {
      background-color: var(--accent-soft);
    }

    .rb-btn-remove {
      padding: 0.2rem 0.55rem;
      border-radius: 5px;
      border: 1px solid #dc2626;
      background-color: transparent;
      color: #dc2626;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
    }

    .preview-panel {
      position: sticky;
      inset-block-start: 5.5rem;
    }

    /* Paper sheet is intentionally forced light for accurate A4 print preview */
    .resume-sheet {
      color-scheme: light;
      background-color: #ffffff;
      color: #1f2937;
      border: 1px solid var(--border-strong);
      border-radius: 8px;
      box-shadow: var(--shadow-md);
      min-block-size: 842px;
      display: flex;
      flex-direction: column;
      font-family: "Plus Jakarta Sans", Arial, Helvetica, sans-serif;
      line-height: 1.4;
      overflow: hidden;
    }

    .pv-top-header {
      padding: 24px 32px 16px;
      text-align: center;
      border-bottom: 2px solid #1b3b6f;
      background-color: #ffffff;
    }

    .pv-resume-of {
      margin: 0 0 2px;
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.14em;
      color: #4b5563;
    }

    .pv-name {
      margin: 0 0 6px;
      font-family: "Plus Jakarta Sans", Arial, Helvetica, sans-serif;
      font-size: 22px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #111827;
    }

    .pv-contact {
      font-size: 11px;
      color: #374151;
      white-space: pre-wrap;
      line-height: 1.45;
    }

    .pv-body {
      display: flex;
      flex: 1 1 auto;
      align-items: stretch;
    }

    .pv-col-left {
      width: 34%;
      background-color: #f4f6f9;
      padding: 18px 20px;
      border-right: 1px solid #dbe2ea;
    }

    .pv-col-right {
      width: 66%;
      background-color: #ffffff;
      padding: 18px 24px;
    }

    .pv-section {
      margin-bottom: 18px;
    }

    .pv-section:last-child {
      margin-bottom: 0;
    }

    .pv-section-title {
      font-family: "Plus Jakarta Sans", Arial, Helvetica, sans-serif;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #1b3b6f;
      border-bottom: 1.5px solid #1b3b6f;
      padding-bottom: 3px;
      margin: 0 0 9px;
    }

    .pv-text,
    .pv-pre-text,
    .pv-list-box {
      font-size: 11px;
      line-height: 1.5;
      color: #1f2937;
      margin: 0;
    }

    .pv-pre-text,
    .pv-list-box {
      white-space: pre-line;
    }

    .pv-job {
      margin-bottom: 13px;
    }

    .pv-job:last-child {
      margin-bottom: 0;
    }

    .pv-job-company {
      font-size: 12px;
      font-weight: 700;
      color: #111827;
      margin-bottom: 2px;
    }

    .pv-job-desc {
      font-size: 10.5px;
      color: #4b5563;
      margin: 0 0 4px;
    }

    .pv-job-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 8px;
      margin-bottom: 3px;
    }

    .pv-job-title {
      font-size: 11.5px;
      font-weight: 600;
      font-style: italic;
      color: #1f2937;
    }

    .pv-job-date {
      font-size: 10px;
      font-weight: 600;
      color: #4b5563;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    .pv-job-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #374151;
      margin-top: 3px;
    }

    .pv-job-tasks {
      font-size: 11px;
      white-space: pre-line;
      color: #1f2937;
      margin-top: 2px;
    }

    .pv-edu-item {
      margin-bottom: 10px;
    }

    .pv-edu-item:last-child {
      margin-bottom: 0;
    }

    .pv-edu-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 8px;
    }

    .pv-edu-degree {
      font-size: 11.5px;
      font-weight: 700;
      color: #111827;
    }

    .pv-edu-year {
      font-size: 10px;
      font-weight: 600;
      color: #4b5563;
      font-variant-numeric: tabular-nums;
    }

    .pv-edu-inst {
      font-size: 11px;
      font-style: italic;
      color: #374151;
    }

    .pv-edu-details {
      font-size: 10.5px;
      color: #374151;
    }

    .pv-detail-row {
      display: flex;
      gap: 6px;
      font-size: 10.5px;
      line-height: 1.5;
      margin-bottom: 2px;
    }

    .pv-detail-label {
      min-width: 84px;
      font-weight: 600;
      color: #374151;
    }

    .pv-detail-value {
      flex: 1;
      color: #111827;
    }

    @media (max-width: 1024px) {
      .builder-grid {
        grid-template-columns: 1fr;
      }

      .preview-panel {
        position: static;
      }
    }

    @media (max-width: 640px) {
      .rb-grid-2 {
        grid-template-columns: 1fr;
      }

      .pv-body {
        flex-direction: column;
      }

      .pv-col-left,
      .pv-col-right {
        width: 100%;
        border-right: none;
      }
    }

    /* Clean A4 PDF Print Layout (no sticky clipping, zero site chrome) */
    @media print {
      @page {
        size: A4;
        margin: 0.4in;
      }

      html,
      body {
        background: #ffffff !important;
        color: #111827 !important;
        min-block-size: auto !important;
      }

      .skip-link,
      .site-header,
      .site-footer,
      .builder-intro,
      .editor-panel {
        display: none !important;
      }

      .builder-workspace {
        inline-size: 100% !important;
        max-inline-size: none !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .builder-grid,
      .preview-panel {
        display: block !important;
        position: static !important;
        inset: auto !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .resume-sheet {
        border: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        min-block-size: auto !important;
        width: 100% !important;
      }

      .pv-body {
        display: flex !important;
        flex-direction: row !important;
      }

      .pv-col-left {
        width: 34% !important;
        border-right: 1px solid #dbe2ea !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      .pv-col-right {
        width: 66% !important;
      }

      .pv-top-header {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
    }
  </style>
</BaseLayout>
