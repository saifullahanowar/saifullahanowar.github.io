---
import { navLinks, profile } from '../data/profile';

const nameParts = profile.fullName.split(' ');
const firstName = nameParts[0] ?? profile.fullName;
const lastName = nameParts.slice(1).join(' ');
---

<header class="site-header" id="site-header">
  <div class="header-inner" id="header-inner">
    <a class="site-logo" href="/" aria-label={`${profile.fullName} — Top of page`}>
      <svg
        aria-hidden="true"
        width="28"
        height="28"
        viewBox="0 0 32 32"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect
          x="2"
          y="2"
          width="28"
          height="28"
          rx="7"
          fill="var(--green)"
          stroke="var(--ink)"
          stroke-width="2"
        />
        <path
          d="M16 7.5L23.5 11.75V20.25L16 24.5L8.5 20.25V11.75L16 7.5Z"
          fill="var(--elevated)"
          stroke="var(--ink)"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
        <path
          d="M16 16L23.5 11.75M16 16V24.5M16 16L8.5 11.75"
          stroke="var(--ink)"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
      </svg>
      <span class="logo-name">
        {firstName}{' '}
        {lastName && <span class="term-highlight">{lastName}</span>}
      </span>
    </a>

    <div class="header-actions">
      <nav class="site-nav" aria-label="Primary">
        <button
          class="menu-button"
          type="button"
          popovertarget="site-menu"
          popovertargetaction="toggle"
          aria-controls="site-menu"
        >
          <svg
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="20" y2="17"></line>
          </svg>
          <span>Menu</span>
        </button>

        <ul id="site-menu" class="site-menu" popover="auto">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <button
        id="theme-toggle"
        class="tool-btn"
        type="button"
        aria-label="Toggle dark mode"
        title="Toggle light/dark paper theme"
      >
        <svg
          class="theme-icon-moon"
          aria-hidden="true"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Lazy-load Popover polyfill ONLY if the browser lacks native Popover support
  if (!('popover' in HTMLElement.prototype)) {
    import('@oddbird/popover-polyfill');
  }

  // Theme toggle
  const themeBtn = document.getElementById('theme-toggle');
  if (themeBtn) {
    const syncThemeButton = () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      themeBtn.setAttribute('aria-pressed', String(isDark));
    };
    syncThemeButton();

    themeBtn.addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      if (isDark) {
        document.documentElement.removeAttribute('data-theme');
        try {
          localStorage.setItem('portfolio-theme', 'light');
        } catch {
          // Ignore storage errors
        }
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        try {
          localStorage.setItem('portfolio-theme', 'dark');
        } catch {
          // Ignore storage errors
        }
      }
      syncThemeButton();
    });
  }

  // Adaptive header navigation
  const header = document.getElementById('site-header');
  const inner = document.getElementById('header-inner');
  const menu = document.getElementById('site-menu');

  if (header && inner && menu) {
    let lastHeaderWidth = 0;

    const isPopoverOpen = (): boolean => {
      try {
        return menu.matches(':popover-open') || menu.classList.contains(':popover-open');
      } catch {
        return menu.classList.contains(':popover-open');
      }
    };

    menu.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('a') && !header.classList.contains('is-wide')) {
        if (typeof menu.hidePopover === 'function') {
          try {
            menu.hidePopover();
          } catch {
            // Ignore if already closed
          }
        }
      }
    });

    const syncNavLayout = (force = false) => {
      const currentWidth = header.clientWidth;
      const isCurrentlyWide = header.classList.contains('is-wide');

      if (!force && !isCurrentlyWide && currentWidth <= lastHeaderWidth) {
        lastHeaderWidth = currentWidth;
        return;
      }
      lastHeaderWidth = currentWidth;

      const wasOpen = !isCurrentlyWide && isPopoverOpen();

      header.classList.add('is-measuring', 'is-wide');
      menu.removeAttribute('popover');

      const fitsInline = inner.scrollWidth <= inner.clientWidth + 1;

      if (!fitsInline) {
        header.classList.remove('is-wide');
        menu.setAttribute('popover', 'auto');
        if (wasOpen && typeof menu.showPopover === 'function') {
          try {
            menu.showPopover();
          } catch {
            // Ignore if already open or polyfill still loading
          }
        }
      }

      requestAnimationFrame(() => {
        header.classList.remove('is-measuring');
      });
    };

    syncNavLayout(true);

    const observer = new ResizeObserver(() => syncNavLayout(false));
    observer.observe(header);
    observer.observe(menu);
  }
</script>
