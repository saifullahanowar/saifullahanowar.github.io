---
import { navLinks, profile } from '../data/profile';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

function normalizePath(path: string): string {
  if (!path || path === '/') return '/';
  return path.endsWith('/') ? path : `${path}/`;
}

const activePath = normalizePath(currentPath);
---

<header class="site-header" id="site-header">
  <div class="header-inner" id="header-inner">
    <a class="site-logo" href="/" aria-label={`${profile.fullName} — Home`}>
      <span class="logo-monogram" aria-hidden="true">{profile.initials}</span>
      <span class="logo-name">{profile.fullName}</span>
    </a>

    <div class="header-controls">
      <nav class="site-nav" aria-label="Primary">
        <button
          class="menu-button"
          type="button"
          popovertarget="site-menu"
          popovertargetaction="toggle"
          aria-controls="site-menu"
        >
          <svg
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="20" y2="17"></line>
          </svg>
          <span>Menu</span>
        </button>

        <ul id="site-menu" class="site-menu" popover="auto">
          {
            navLinks.map((link) => {
              const isCurrent = normalizePath(link.href) === activePath;
              return (
                <li>
                  <a href={link.href} aria-current={isCurrent ? 'page' : undefined}>
                    {link.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <button type="button" class="theme-toggle" id="theme-toggle">
        <span class="theme-option theme-to-dark">
          <svg
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span class="sr-only">Switch to dark theme</span>
        </span>
        <span class="theme-option theme-to-light">
          <svg
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <span class="sr-only">Switch to light theme</span>
        </span>
      </button>
    </div>
  </div>
</header>

<script>
  // Lazy-load Popover polyfill ONLY if the browser lacks native Popover support
  if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
    import('@oddbird/popover-polyfill');
  }

  // 1. Two-state theme toggle synced with <meta name="color-scheme"> and localStorage
  const THEME_KEY = 'color-scheme';
  const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
  const themeToggle = document.getElementById('theme-toggle');
  const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');

  function readStoredScheme(): 'light' | 'dark' | null {
    try {
      const value = localStorage.getItem(THEME_KEY);
      return value === 'light' || value === 'dark' ? value : null;
    } catch {
      return null;
    }
  }

  function applyMetaScheme(scheme: 'light' | 'dark' | null) {
    if (themeMeta) {
      themeMeta.content = scheme ?? 'light dark';
    }
  }

  themeToggle?.addEventListener('click', () => {
    const stored = readStoredScheme();
    const system: 'light' | 'dark' = darkQuery.matches ? 'dark' : 'light';
    const rendered: 'light' | 'dark' = stored ?? system;
    const target: 'light' | 'dark' = rendered === 'dark' ? 'light' : 'dark';

    try {
      if (target === system) {
        localStorage.removeItem(THEME_KEY);
        applyMetaScheme(null);
      } else {
        localStorage.setItem(THEME_KEY, target);
        applyMetaScheme(target);
      }
    } catch {
      applyMetaScheme(target === system ? null : target);
    }
  });

  window.addEventListener('storage', (event) => {
    if (event.key === THEME_KEY) {
      const next =
        event.newValue === 'light' || event.newValue === 'dark' ? event.newValue : null;
      applyMetaScheme(next);
    }
  });

  // 2. Adaptive inline-vs-popover navigation driven by measured container fit
  const header = document.getElementById('site-header');
  const inner = document.getElementById('header-inner');
  const menu = document.getElementById('site-menu');

  if (header && inner && menu) {
    let lastHeaderWidth = 0;

    const isPopoverOpen = (): boolean => {
      try {
        return menu.matches(':popover-open') || menu.classList.contains(':popover-open');
      } catch {
        return menu.classList.contains(':popover-open');
      }
    };

    const syncNavLayout = (force = false) => {
      const currentWidth = header.clientWidth;
      const isCurrentlyWide = header.classList.contains('is-wide');

      // While collapsed, only remeasure when the header grows (avoids layout thrash on shrink)
      if (!force && !isCurrentlyWide && currentWidth <= lastHeaderWidth) {
        lastHeaderWidth = currentWidth;
        return;
      }
      lastHeaderWidth = currentWidth;

      const wasOpen = !isCurrentlyWide && isPopoverOpen();

      header.classList.add('is-measuring', 'is-wide');
      menu.removeAttribute('popover');

      const fitsInline = inner.scrollWidth <= inner.clientWidth + 1;

      if (!fitsInline) {
        header.classList.remove('is-wide');
        menu.setAttribute('popover', 'auto');
        if (wasOpen && typeof menu.showPopover === 'function') {
          try {
            menu.showPopover();
          } catch {
            // Ignore if already open or polyfill still loading
          }
        }
      }

      requestAnimationFrame(() => {
        header.classList.remove('is-measuring');
      });
    };

    syncNavLayout(true);

    const observer = new ResizeObserver(() => syncNavLayout(false));
    observer.observe(header);
    observer.observe(menu);
  }
</script>
